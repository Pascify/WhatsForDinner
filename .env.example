# MongoDB Atlas M0
MONGODB_URI=
MONGODB_DB=whatsfordinner

# Random string; hashes one-time codes before they are stored
CODE_PEPPER=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# The test number in full international form, digits only. Used to build wa.me links.
WHATSAPP_DISPLAY_NUMBER=
# Optional, defaults to v23.0. Match whatever the Meta dashboard shows.
WHATSAPP_GRAPH_VERSION=
# Optional: only needed when the paid fallback is switched on
WHATSAPP_TEMPLATE_WEEKLY=whatsfordinner_weekly
WHATSAPP_TEMPLATE_DAILY=whatsfordinner_daily
WHATSAPP_TEMPLATE_READY=whatsfordinner_ready
WHATSAPP_TEMPLATE_LANGUAGE=en

# Gmail account with 2-step verification and an app password
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Shared with the GitHub Actions workflow
CRON_SECRET=

# Public address, used in login links
APP_URL=https://hammad.vercel.app/projects/whatsfordinner
