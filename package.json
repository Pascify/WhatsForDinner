{
  "name": "whatsfordinner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "setup-db": "tsx --env-file-if-exists=.env.local scripts/setup-db.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project node --exclude '**/*.integration.test.ts' --exclude '**/node_modules/**'",
    "test:integration": "vitest run integration",
    "test:dom": "vitest run --project dom",
    "preflight": "tsx --env-file-if-exists=.env.local scripts/preflight.mts",
    "check:rules": "tsx scripts/check-rules.mts",
    "doctor": "tsx --env-file-if-exists=.env.local scripts/doctor.mts"
  },
  "dependencies": {
    "mongodb": "^7.6.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.17.1"
}
